# Anthropic API Key (from your Agent Command Centre)
ANTHROPIC_API_KEY=sk-ant-...

# Twilio credentials (from twilio.com/console)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token_here

# Your Twilio WhatsApp number (e.g. whatsapp:+14155238886 for sandbox)
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# Optional: OpenAI API key for high-quality voice transcription
# If blank, Twilio's built-in transcription is used instead
OPENAI_API_KEY=
